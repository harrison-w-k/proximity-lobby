# Copy to client/.env.local. The Node server reads the same file (npm start / npm run dev:server),
# and the Cloudflare Worker gets the same two values from "vars" in wrangler.jsonc. The anon key is public by design;
# protect data with Row Level Security, and never put the service_role key in the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server (set in your host's dashboard, optional): TURN relay for strict NATs
# TURN_URL=turn:example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
