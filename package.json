{
  "name": "proxchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=client/.env.local server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=client/.env.local server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "tsx client/src/collision.test.ts && tsx shared/lobby.test.ts && tsx shared/movement.test.ts && tsx shared/arena/terrain.test.ts && tsx shared/arena/predict.test.ts && tsx shared/arena/combat.test.ts && tsx shared/arena/match.test.ts",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.0.0",
    "three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.151.0"
  }
}
